<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.scenes.AddRecipeCtrl">

    <top>
        <HBox prefHeight="45.0" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8" left="10" right="10" top="8" />
            </padding>

            <Button onAction="#goBack" text="%button.back" />
            <Label text="%addRecipe.title">
                <font><Font size="20" /></font>
            </Label>

            <Pane HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="12" left="12" right="12" top="10" />
            </padding>

            <!-- Basic info -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="%addRecipe.nameLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" promptText="%addRecipe.namePrompt"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="%addRecipe.languageLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="languageCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="%addRecipe.servingsLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="servingsNumber" maxWidth="150.0" prefHeight="26.0" prefWidth="150.0"
                           promptText="%addRecipe.servingsPrompt"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <Separator />

            <!-- Ingredients + Instructions side by side -->
            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">

                <!-- Ingredients -->
                <VBox spacing="8">
                    <padding>
                        <Insets bottom="0" left="0" right="10" top="0" />
                    </padding>

                    <Label style="-fx-font-weight: bold;" text="%addRecipe.ingredientsTitle" />

                    <HBox spacing="8">
                        <!-- Ingredient dropdown from server -->
                        <ComboBox fx:id="ingredientCombo" onMouseClicked="#updateIngredients"
                                  promptText="%addRecipe.ingredientPrompt"
                                  HBox.hgrow="ALWAYS" />

                        <!-- Amount -->
                        <TextField fx:id="ingredientAmountField" prefWidth="90"
                                   promptText="%addRecipe.amountPrompt" />

                        <!-- Unit enum dropdown -->
                        <ComboBox fx:id="unitCombo" prefWidth="120"
                                  promptText="%addRecipe.unitPrompt" />

                        <Button onAction="#addIngredient" text="%button.add" />
                    </HBox>

                    <ListView fx:id="ingredientsList" VBox.vgrow="ALWAYS" />

                    <HBox spacing="8">
                        <Button onAction="#removeSelectedIngredient" text="%button.removeSelected" />
                        <Button onAction="#clearIngredients" text="%button.clear" />
                        <Button mnemonicParsing="false" onAction="#createNewIngredient"
                                text="%addRecipe.createNewIngredient" />
                    </HBox>
                </VBox>

                <!-- Instructions -->
                <VBox spacing="8">
                    <padding>
                        <Insets bottom="0" left="10" right="0" top="0" />
                    </padding>

                    <Label style="-fx-font-weight: bold;" text="%addRecipe.instructionsTitle" />

                    <HBox spacing="8">
                        <TextArea fx:id="instructionArea" prefHeight="38.0" prefRowCount="3" prefWidth="145.0"
                                  promptText="%addRecipe.instructionPrompt"
                                  wrapText="true" HBox.hgrow="ALWAYS" />
                        <Button onAction="#addInstruction" text="%button.add" />
                    </HBox>

                    <ListView fx:id="instructionsList" VBox.vgrow="ALWAYS" />

                    <HBox spacing="8">
                        <Button onAction="#moveInstructionUp" text="%button.moveUp" />
                        <Button onAction="#moveInstructionDown" text="%button.moveDown" />
                        <Button onAction="#removeSelectedInstruction" text="%button.removeSelected" />
                        <Button onAction="#clearInstructions" text="%button.clear" />
                    </HBox>
                </VBox>

            </SplitPane>

            <Label fx:id="errorLabel" style="-fx-text-fill: red;" text="" />
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" BorderPane.alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="12" left="12" right="12" top="8" />
            </padding>

            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#goBack" text="%button.cancel" />
            <Button defaultButton="true" onAction="#createRecipe" text="%button.create" />
        </HBox>
    </bottom>

</BorderPane>

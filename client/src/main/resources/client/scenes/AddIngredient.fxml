<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.AddIngredientCtrl">

    <top>
        <HBox prefHeight="45.0" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8" left="10" right="10" top="8" />
            </padding>

            <Button onAction="#goBack" text="← Back" />
            <Label text="Create Ingredient">
                <font><Font size="20" /></font>
            </Label>

            <Pane HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="12" left="12" right="12" top="10" />
            </padding>

            <!-- Basic info -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Ingredient name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" promptText="e.g. Salt" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
            </GridPane>
         <GridPane hgap="10" vgap="10">
            <columnConstraints>
               <ColumnConstraints minWidth="120" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
               <Label text="Amount of fat" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="fatField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </children>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
         </GridPane>
         <GridPane hgap="10" vgap="10">
            <columnConstraints>
               <ColumnConstraints minWidth="120" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
               <Label text="Amount of protein" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="proteinField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </children>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
         </GridPane>
         <GridPane hgap="10" vgap="10">
            <columnConstraints>
               <ColumnConstraints minWidth="120" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
               <Label text="Amount of carbs" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="carbsField" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </children>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
         </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox prefHeight="0.0" prefWidth="900.0" spacing="10" BorderPane.alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="12" left="12" right="12" top="8" />
            </padding>

            <Pane HBox.hgrow="ALWAYS">
            <children>
               <Label fx:id="errorLabel" layoutX="318.0" layoutY="3.0" textFill="RED" />
            </children></Pane>
            <Button onAction="#goBack" text="Cancel" />
            <Button defaultButton="true" onAction="#createIngredient" text="Create" />
        </HBox>
    </bottom>

</BorderPane>

       <VBox spacing="8">
           <padding>
               <Insets top="10" right="10" bottom="10" left="10"/>
           </padding>
           <Label fx:id="recipeName">
               <font>
                   <Font size="18"/>
               </font>
           </Label>

           <Label text="Ingredients"/>
           <ListView fx:id="ingredientsList" prefHeight="120"/>

           <Label text="Instructions"/>
           <ListView fx:id="instructionsList" prefHeight="120"/>

           <Label fx:id="recipeLanguage"/>
       </VBox>
   </center>
   <top>
      <HBox prefHeight="35.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Pane prefHeight="37.0" prefWidth="275.0" HBox.hgrow="ALWAYS">
               <children>
                  <ToolBar layoutY="-2.0" prefHeight="40.0" prefWidth="164.0">
                    <items>
                        <Button fx:id="favoritesButton" mnemonicParsing="false" onAction="#goToFavorites" text="Favorites" />
                        <Button fx:id="ingredientsButton" mnemonicParsing="false" onAction="#goToIngredients" text="Ingredients" />
                    </items>
                  </ToolBar>
               </children></Pane>
            <Label prefHeight="37.0" prefWidth="152.0" text="FoodPal" textAlignment="CENTER">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Pane prefHeight="37.0" prefWidth="166.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refresh" prefHeight="55.0" prefWidth="47.0" style="-fx-padding: 5 5;" text="⟳">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="160.0" BorderPane.alignment="CENTER">

            <Label prefHeight="18.0" prefWidth="150.0" text="All Recipes">
               <font>
                  <Font size="14.0" />
               </font>
            </Label> <ListView
                 fx:id="recipeListView"
                 VBox.vgrow="ALWAYS"
                 prefWidth="138.0"/>
         </children>
      </VBox>
   </left>
